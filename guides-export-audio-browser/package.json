{
  "name": "cesdk-export-audio-browser",
  "version": "1.0.0",
  "description": "CE.SDK example demonstrating audio export and caption generation",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:all",
    "build": "vite build",
    "preview": "vite preview",
    "check:syntax": "tsc --project tsconfig.json --noEmit",
    "check:format": "prettier --check \"**/*.{ts,js,json,html}\"",
    "check:lint": "eslint \"**/*.{ts,js}\"",
    "check:all": "npm run check:syntax && npm run check:format && npm run check:lint",
    "fix:format": "prettier --write \"**/*.{ts,js,json,html}\"",
    "fix:lint": "eslint --fix \"**/*.{ts,js}\"",
    "fix:all": "npm run fix:format && npm run fix:lint",
    "test": "exit 0",
    "qa": "npm run build && npm run test",
    "ci": "npm run check:all && npm run qa",
    "capture:hero_image": "node scripts/capture-hero.mjs"
  },
  "dependencies": {
    "@cesdk/cesdk-js": "^1.75.0-rc.4",
    "@cesdk/engine": "^1.75.0-rc.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-jsdoc": "^46.0.0",
    "playwright": "^1.40.0",
    "prettier": "^3.0.0",
    "sharp": "^0.33.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  },
  "keywords": [
    "cesdk",
    "audio",
    "export",
    "captions",
    "transcription",
    "creative-editor-sdk"
  ],
  "author": "IMG.LY",
  "license": "MIT"
}
