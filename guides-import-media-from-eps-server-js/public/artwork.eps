%!PS-Adobe-3.0 EPSF-3.0
%%Title: Synthetic cyan and K-only artwork
%%Creator: IMG.LY EPS import example
%%BoundingBox: 10 20 310 220
%%HiResBoundingBox: 10.000 20.000 310.000 220.000
%%LanguageLevel: 2
%%Pages: 1
%%EndComments
gsave
0 0 0 1 setcmykcolor
10 20 300 200 rectfill
1 0 0 0 setcmykcolor
newpath 110 120 70 0 360 arc fill
0 0 0 0 setcmykcolor
80 130 145 25 rectfill
80 80 110 25 rectfill
grestore
showpage
%%EOF
